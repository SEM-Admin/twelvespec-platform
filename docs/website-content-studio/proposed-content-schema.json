{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:twelvespec:review:website-document:v1",
  "title": "PROPOSED TwelveSpec website document contract",
  "description": "Review artifact only, not a runtime validator. Does not create database records or authorize publication. Only 18 page blocks; header/footer are global documents. Private evidence is removed by the public projection.",
  "oneOf": [
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/navigation"
    },
    {
      "$ref": "#/$defs/theme"
    },
    {
      "$ref": "#/$defs/footer"
    }
  ],
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "enum": [
            "PAGE",
            "COLLECTION",
            "SOLUTION",
            "STORE",
            "WORKFLOW",
            "EXTERNAL_HTTPS"
          ]
        },
        "targetId": {
          "type": "string",
          "format": "uuid"
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "label",
        "kind"
      ],
      "description": "Server enforces exactly the target fields required by kind, same-site grants, reserved workflow routes and safe HTTPS allowlist. Schema alone cannot prove link safety."
    },
    "richNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "paragraph",
            "heading",
            "list",
            "list_item",
            "text",
            "link"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "level": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "marks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "strong",
              "emphasis"
            ]
          }
        },
        "link": {
          "$ref": "#/$defs/link"
        },
        "children": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/richNode"
          }
        }
      },
      "required": [
        "type"
      ],
      "description": "Illustrative bounded semantic AST. Runtime must enforce valid node shape per type, depth <= 8, document size and semantic link validation; never interpret text as HTML."
    },
    "richText": {
      "type": "array",
      "minItems": 0,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/richNode"
      }
    },
    "galleryItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "focalPoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      },
      "required": [
        "assetId",
        "alt"
      ]
    },
    "testimonial": {
      "type": "object",
